<%= form_with model: task, data: { turbo_frame: "_top" }, class: "space-y-6" do |form| %>
  
  <div>
    <%= form.label :title, class: "block text-sm font-bold text-slate-700 mb-2" %>
    <%= form.text_field :title, class: "w-full border border-slate-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all", placeholder: "e.g., Update Server Infrastructure", autofocus: true %>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-bold text-slate-700 mb-2" %>
    <%= form.text_area :description, rows: 4, class: "w-full border border-slate-300 rounded-lg p-3 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all", placeholder: "Task specifics..." %>
  </div>

  <div class="pt-2 flex justify-end gap-3">
    <%= link_to "Cancel", tasks_path, class: "px-5 py-2.5 rounded-lg text-slate-600 font-semibold hover:bg-slate-100 transition-colors" %>
    <%= form.submit class: "bg-blue-600 hover:bg-blue-500 text-white font-bold py-2.5 px-6 rounded-lg shadow-md cursor-pointer transition duration-200" %>
  </div>

<% end %>