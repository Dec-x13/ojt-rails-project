<div class="max-w-3xl mx-auto mt-10">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-4xl font-extrabold text-gray-900">My Tasks</h1>
    <%= link_to "New Task", new_task_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg shadow transition duration-200" %>
  </div>

  <div class="space-y-4">
    <% @tasks.each do |task| %>
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 flex flex-col hover:shadow-md transition duration-200">
        
        <div class="flex justify-between items-start">
          <div>
            <h2 class="text-xl font-bold text-gray-800 mb-2"><%= task.title %></h2>
            <p class="text-gray-600"><%= task.description %></p>
          </div>
          
          <%= button_to "Delete", task_path(task), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-800 font-semibold text-sm py-1 px-3 border border-red-200 hover:bg-red-50 rounded transition duration-200" %>
        </div>

      </div>
    <% end %>
  </div>
</div>