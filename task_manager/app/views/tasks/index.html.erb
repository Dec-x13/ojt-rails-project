<%= turbo_frame_tag "modal" %>
<div class="min-h-screen bg-slate-50 font-sans pb-16">
  
  <header class="bg-[#041E42] text-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="text-blue-400 font-extrabold text-2xl tracking-tighter">
          &lt;/&gt;
        </div>
        <span class="text-xl font-bold tracking-wide">TechNavy<span class="font-light">Tasks</span></span>
      </div>
      
      <div class="flex items-center gap-6">
        <nav class="hidden sm:block text-sm font-medium space-x-6">
          <a href="https://github.com/Dec-x13/ojt-rails-project" target="_blank" class="hover:text-blue-400 transition-colors">GitHub Repository</a>
        </nav>

        <% if current_user %>
          <div class="flex items-center gap-4 border-l border-slate-700 pl-6">
            <span class="text-sm font-medium text-slate-300"><%= current_user.email %></span>
            
            <%= button_to "Log Out", logout_path, method: :delete, class: "text-sm font-bold text-slate-300 hover:text-white transition-colors cursor-pointer bg-transparent border border-slate-600 hover:border-slate-400 px-3 py-1.5 rounded" %>
          </div>
        <% end %>
      </div>
    </div>
  </header>

  <div class="max-w-4xl mx-auto text-center mt-16 mb-16 px-4">
    <h1 class="text-4xl md:text-5xl font-extrabold text-[#041E42] mb-4 tracking-tight">
      Task Manager App<span class="text-blue-500"> With Tailwind CSS</span>
    </h1>
    <p class="text-slate-500 text-lg mb-8 max-w-2xl mx-auto">
      Centralized digital task management built for scalability, seamless connectivity, and data-driven governance.
    </p>
    <div>
       <%= link_to "Create New Task", new_task_path, data: { turbo_frame: "modal" }, class: "bg-[#041E42] hover:bg-blue-900 text-white font-semibold py-3 px-8 rounded-full shadow-lg transition duration-200" %>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-center text-3xl font-extrabold text-[#041E42] uppercase tracking-wider mb-12">
      TASKS:
    </h2>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 items-start">
        
        <% @tasks.each do |task| %>
          <div class="bg-white rounded-lg shadow-sm border <%= task.completed ? 'border-green-200 bg-slate-50/50' : 'border-slate-200 hover:border-blue-300' %> hover:shadow-md transition-all overflow-hidden relative">
            
            <div class="absolute top-0 left-0 w-full h-1 <%= task.completed ? 'bg-green-500' : 'bg-[#041E42]' %> transition-colors"></div>

            <details class="group marker:hidden">
              <summary class="list-none cursor-pointer p-5 pt-6 flex items-start justify-between outline-none">
                
                <div class="flex items-start gap-3 pr-4">
                  
                  <%= button_to toggle_task_path(task), method: :patch, form: { onclick: "event.stopPropagation();" }, class: "mt-0.5 shrink-0 transition-transform hover:scale-110" do %>
                    <% if task.completed %>
                      <svg class="w-6 h-6 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                      </svg>
                    <% else %>
                      <svg class="w-6 h-6 text-slate-300 hover:text-green-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <circle cx="12" cy="12" r="9" stroke-width="2" />
                      </svg>
                    <% end %>
                  <% end %>

                  <h3 class="text-lg font-bold <%= task.completed ? 'text-slate-400 line-through' : 'text-[#041E42] group-hover:text-blue-600' %> transition-colors leading-tight">
                    <%= task.title %>
                  </h3>
                </div>
                
                <div class="shrink-0 mt-0.5 text-slate-400 group-open:rotate-180 transition-transform duration-200">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </summary>

              <div class="px-5 pb-5">
                <p class="text-sm text-slate-600 leading-relaxed whitespace-pre-wrap mb-5"><%= task.description %></p>
                
                <div class="bg-slate-50 rounded-md p-4 border border-slate-100 mb-5">
                  <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-3">System Notes</h4>
                  
                  <div class="space-y-2 mb-3">
                    <% task.comments.each do |comment| %>
                      <div class="flex justify-between items-start group/note">
                        <p class="text-xs text-slate-700 font-medium">↳ "<%= comment.body %>"</p>
                        <%= button_to "✕", task_comment_path(task, comment), method: :delete, class: "text-slate-300 hover:text-red-500 opacity-0 group-hover/note:opacity-100 transition-opacity text-[10px]" %>
                      </div>
                    <% end %>
                  </div>

                  <%= form_with model: [task, task.comments.build], class: "flex gap-2 mt-3" do |form| %>
                    <%= form.text_field :body, placeholder: "Add system note...", class: "flex-grow text-xs border border-slate-200 rounded px-2 py-1.5 focus:outline-none focus:ring-1 focus:ring-blue-500 bg-white" %>
                    <%= form.submit "Save", class: "bg-[#041E42] hover:bg-blue-800 text-white font-bold py-1.5 px-3 rounded text-xs cursor-pointer transition-colors" %>
                  <% end %>
                </div>

                <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
                  <%= link_to "Edit", edit_task_path(task), data: { turbo_frame: "modal" }, class: "text-xs font-bold text-[#041E42] hover:text-blue-600 px-3 py-1.5 border border-slate-200 rounded hover:border-blue-300 transition-colors bg-white" %>
                  <%= button_to "Delete", task, method: :delete, class: "text-xs font-bold text-red-600 hover:text-white hover:bg-red-600 px-3 py-1.5 border border-red-200 rounded transition-colors bg-white" %>
                </div>
              </div>

            </details>
          </div>
        <% end %>

      </div>
    </div>
  </div>
</div>