<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden border border-slate-200">
      
      <div class="bg-[#041E42] px-6 py-4 flex justify-between items-center text-white">
        <h2 class="text-xl font-bold tracking-wide">Edit System Task</h2>
        <%= link_to "✕", tasks_path, class: "text-slate-300 hover:text-white text-2xl font-bold leading-none transition-colors" %>
      </div>

      <div class="p-8">
        <%= render "form", task: @task %>
      </div>
      
    </div>
  </div>
<% end %>